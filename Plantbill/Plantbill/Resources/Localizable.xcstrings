        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കടം അടച്ചതായി അടയാളപ്പെടുത്തുന്നതിന് മുമ്പ് ഇത് നിങ്ങളുടെ മാനേജർക്ക് അംഗീകാരത്തിനായി അയയ്ക്കും."
          }
        }
      }
    },
