    "Add a plant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a plant"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചെടി ചേർക്കുക"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पौधा जोड़ें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಂದು ಸಸ್ಯ ಸೇರಿಸಿ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு செடியைச் சேர்"
          }
        }
      }
    },
    "Add a worker first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a worker first."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം ഒരു തൊഴിലാളിയെ ചേർക്കുക."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक मज़दूर जोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲು ಒಬ್ಬ ಕಾರ್ಮಿಕನನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் ஒரு தொழிலாளியைச் சேர்."
          }
        }
      }
    },
    "Add another plant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add another plant"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു ചെടി ചേർക്കുക"
          }
        }
      }
    },
    "Add borrowing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add borrowing"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കടം ചേർക്കുക"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उधार जोड़ें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಲ ಸೇರಿಸಿ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடனைச் சேர்"
          }
        }
      }
    },
    "Add expense": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add expense"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചെലവ് രേഖപ്പെടുത്തുക"
          }
        }
      }
    },
    "Add many products at once from a spreadsheet, then attach photos by file name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add many products at once from a spreadsheet, then attach photos by file name."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു സ്‌പ്രെഡ്‌ഷീറ്റിൽ നിന്ന് ഒരുമിച്ച് ഒട്ടേറെ സാധനങ്ങൾ ചേർക്കുക, പിന്നെ ഫയൽ പേര് വഴി ഫോട്ടോകൾ ചേർക്കുക."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्प्रेडशीट से एक साथ कई सामान जोड़ें, फिर फ़ाइल नाम से फ़ोटो जोड़ें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪ್ರೆಡ್‌ಶೀಟ್‌ನಿಂದ ಒಟ್ಟಿಗೆ ಹಲವು ಸರಕುಗಳನ್ನು ಸೇರಿಸಿ, ನಂತರ ಫೈಲ್ ಹೆಸರಿನ ಮೂಲಕ ಫೋಟೋಗಳನ್ನು ಲಗತ್ತಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு விரிதாளிலிருந்து பல பொருட்களை ஒரே நேரத்தில் சேர்க்கவும், பிறகு கோப்புப் பெயர் மூலம் புகைப்படங்களை இணைக்கவும்."
          }
        }
      }
    },
    "Add product": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add product"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധനം ചേർക്കുക"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान जोड़ें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಸ್ತು ಸೇರಿಸಿ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருள் சேர்"
          }
        }
      }
    },
    "Add products in the Products tab, or use Quick add.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add products in the Products tab, or use Quick add."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സാധനങ്ങൾ ടാബിൽ സാധനങ്ങൾ ചേർക്കുക, അല്ലെങ്കിൽ വേഗത്തിൽ ചേർക്കൽ ഉപയോഗിക്കുക."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामान टैब में सामान जोड़ें, या जल्दी जोड़ें का उपयोग करें।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸರಕುಗಳು ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಸರಕುಗಳನ್ನು ಸೇರಿಸಿ, ಅಥವಾ ತ್ವರಿತ ಸೇರಿಸುವಿಕೆ ಬಳಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பொருட்கள் தாவலில் பொருட்களைச் சேர்க்கவும், அல்லது விரைவு சேர்ப்பைப் பயன்படுத்தவும்."
          }
        }
      }
    },
    "Add salesperson": {
      "localizations": {
        "en": {
          "stringUnit": {
