    "Active (shown in billing)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active (shown in billing)"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സജീവം (ബില്ലിംഗിൽ കാണിക്കും)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय (बिलिंग में दिखता है)"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಕ್ರಿಯ (ಬಿಲ್ಲಿಂಗ್‌ನಲ್ಲಿ ತೋರಿಸಲಾಗುತ್ತದೆ)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலில் (பில்லிங்கில் காட்டப்படும்)"
          }
