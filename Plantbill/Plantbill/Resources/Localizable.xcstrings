    "Add your first salesperson account below.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your first salesperson account below."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൗണ്ടറിൽ ബിൽ ചെയ്യാൻ ഒരു വിൽപനക്കാരനെ ചേർക്കുക."
          }
        }
      }
    },
    "Adds a one-off item to this bill (saved under \"Quick Add\").": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a one-off item to this bill (saved under \"Quick Add\")."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ബില്ലിലേക്ക് ഒറ്റത്തവണ സാധനം ചേർക്കുന്നു (\"വേഗത്തിൽ ചേർക്കൽ\" എന്നതിന് കീഴിൽ സൂക്ഷിക്കും)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिल में एक बार का सामान जोड़ता है (\"जल्दी जोड़ें\" के तहत सहेजा जाता है)।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಿಲ್‌ಗೆ ಒಂದು ಬಾರಿಯ ವಸ್ತುವನ್ನು ಸೇರಿಸುತ್ತದೆ (\"ತ್ವರಿತ ಸೇರಿಸುವಿಕೆ\" ಅಡಿಯಲ್ಲಿ ಉಳಿಸಲಾಗುತ್ತದೆ)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
