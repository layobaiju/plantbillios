          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಬ್ಬಂದಿ ಸೇರಿಸಿ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
