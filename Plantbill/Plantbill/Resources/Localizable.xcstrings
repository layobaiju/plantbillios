    "Add worker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add worker"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തൊഴിലാളിയെ ചേർക്കുക"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मज़दूर जोड़ें"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾರ್ಮಿಕನನ್ನು ಸೇರಿಸಿ"
          }
        },
        "ta": {
